# Copy to .env. Generate separate random secrets before starting the server.
# .env, SQLite databases and runtime data must remain outside source control.
ROUTER_RUNTIME_MODE=internal
ROUTER_INTERNAL_API_KEY=
ROUTER_ENABLE_STANDALONE_KEYS=false
ROUTER_ENABLE_ADMIN_API=true
ROUTER_ENABLE_USAGE_API=false
ADMIN_API_KEY=
ROUTER_DB=router.db

# RSL is opt-in globally AND per routing profile.
ROUTER_RSL_ENABLED=false
ROUTER_RSL_DB=rsl.db

# Avoid network/model discovery on startup by default.
AUTO_SYNC_PROVIDER_MODELS=false
AUTO_SYNC_PROVIDER_MODELS_TIMEOUT=10

# Add a real provider in config/providers.yaml before using these variables.
# OPENAI_BASE_URL=https://your-provider.example/v1
# OPENAI_KEY_1=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_KEY_1=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_KEY_1=

# Standalone compatibility only. Internal mode uses ROUTER_INTERNAL_API_KEY.
# ROUTER_API_KEY=
