# Local environment and secrets. Keep committed example templates instead.
.env
.env.local
.env.*.local
.env.*
!.env.example

# Local SQLite databases and their journal files.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# Python bytecode and caches.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.embed_cache/
*.egg-info/
build/
dist/

# Generated benchmark executions.
runs/
artifacts/
local-data/

# Runtime logs.
logs/
*.log
*.log.*
